// Modèle de données complet (sprint 1).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Énumérations ----------

enum Role {
  ADMIN
  EDITOR
  CONTRIBUTOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleKind {
  MASS
  CONFESSION
  ADORATION
  OTHER
}

enum FormType {
  CONTACT
  MEMBERSHIP
  CATECHISM
  SACRAMENT
  MASS_INTENTION
}

enum SubmissionStatus {
  NEW
  PROCESSED
  ARCHIVED
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ---------- Utilisateurs et sessions ----------

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  firstName    String    @db.VarChar(100)
  lastName     String    @db.VarChar(100)
  role         Role      @default(CONTRIBUTOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  pages         Page[]
  announcements Announcement[]
  homilies      Homily[]
  media         Media[]
  submissions   FormSubmission[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    Int
  expiresAt DateTime
  userAgent String?  @db.VarChar(255)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------- Contenus ----------

model Page {
  id             Int           @id @default(autoincrement())
  slug           String        @db.VarChar(191)
  locale         String        @default("fr") @db.VarChar(5)
  title          String        @db.VarChar(255)
  excerpt        String?       @db.VarChar(500)
  content        String        @db.Text
  status         PublishStatus @default(DRAFT)
  seoTitle       String?       @db.VarChar(255)
  seoDescription String?       @db.VarChar(320)
  publishedAt    DateTime?
  authorId       Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([slug, locale])
  @@index([status])
  @@map("pages")
}

model Announcement {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  content     String        @db.Text
  // Version anglaise (facultative) : sans elle, le site anglais affiche le français.
  titleEn     String?       @db.VarChar(255)
  contentEn   String?       @db.Text
  pinned      Boolean       @default(false)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?
  authorId    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("announcements")
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String   @db.VarChar(255)
  storagePath  String   @unique @db.VarChar(500)
  mimeType     String   @db.VarChar(100)
  size         Int
  alt          String?  @db.VarChar(255)
  uploadedById Int?
  createdAt    DateTime @default(now())

  uploadedBy  User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  bulletins   Bulletin[]
  staff       StaffMember[]
  albumItems  AlbumItem[]
  albumCovers Album[]

  @@map("media")
}

model Bulletin {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  date        DateTime      @db.Date
  fileId      Int
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  file Media @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([date])
  @@map("bulletins")
}

model EventCategory {
  id     Int     @id @default(autoincrement())
  name   String  @db.VarChar(100)
  slug   String  @unique @db.VarChar(100)
  color  String? @db.VarChar(20)
  events Event[]

  @@map("event_categories")
}

model Event {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  description String?       @db.Text
  location    String?       @db.VarChar(255)
  // Version anglaise (facultative)
  titleEn       String? @db.VarChar(255)
  descriptionEn String? @db.Text
  locationEn    String? @db.VarChar(255)
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean       @default(false)
  recurrence  String?       @db.VarChar(255)
  status      PublishStatus @default(DRAFT)
  categoryId  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category EventCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@map("events")
}

model MassSchedule {
  id        Int          @id @default(autoincrement())
  weekday   Weekday
  time      String       @db.VarChar(5)
  kind      ScheduleKind @default(MASS)
  language  String?      @db.VarChar(50)
  location  String?      @db.VarChar(255)
  notes     String?      @db.VarChar(255)
  active    Boolean      @default(true)
  sortOrder Int          @default(0)

  @@index([weekday, time])
  @@map("mass_schedules")
}

model StaffMember {
  id        Int     @id @default(autoincrement())
  fullName  String  @db.VarChar(150)
  function  String  @db.VarChar(150)
  bio       String? @db.Text
  photoId   Int?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  photo Media? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@map("staff_members")
}

model Homily {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  preacher    String?       @db.VarChar(150)
  date        DateTime      @db.Date
  content     String?       @db.Text
  audioUrl    String?       @db.VarChar(500)
  videoUrl    String?       @db.VarChar(500)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("homilies")
}

// ---------- Démarches en ligne ----------

model FormSubmission {
  id          Int              @id @default(autoincrement())
  type        FormType
  status      SubmissionStatus @default(NEW)
  fullName    String?          @db.VarChar(150)
  email       String?          @db.VarChar(191)
  phone       String?          @db.VarChar(40)
  payload     Json
  ip          String?          @db.VarChar(64)
  handledById Int?
  handledAt   DateTime?
  createdAt   DateTime         @default(now())

  handledBy User? @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([createdAt])
  @@map("form_submissions")
}

// ---------- Dons ----------

model Campaign {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(191)
  description String?       @db.Text
  goalAmount  Int?
  currency    String        @default("XOF") @db.VarChar(3)
  startsAt    DateTime?
  endsAt      DateTime?
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  donations Donation[]

  @@map("campaigns")
}

model Donation {
  id          Int            @id @default(autoincrement())
  reference   String         @unique @db.VarChar(64)
  amount      Int
  currency    String         @default("XOF") @db.VarChar(3)
  status      DonationStatus @default(PENDING)
  method      String?        @db.VarChar(20)
  provider    String         @db.VarChar(50)
  providerRef String?        @db.VarChar(191)
  donorName   String?        @db.VarChar(150)
  donorEmail  String?        @db.VarChar(191)
  donorPhone  String?        @db.VarChar(40)
  message     String?        @db.VarChar(500)
  note        String?        @db.VarChar(255)
  campaignId  Int?
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("donations")
}

// ---------- Divers ----------

model Subscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  locale         String    @default("fr") @db.VarChar(5)
  confirmed      Boolean   @default(false)
  unsubscribedAt DateTime?
  token          String?   @unique @db.VarChar(64)
  createdAt      DateTime  @default(now())

  @@map("subscribers")
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------- Newsletter ----------

model Newsletter {
  id          Int       @id @default(autoincrement())
  subject     String    @db.VarChar(255)
  content     String    @db.Text
  status      String    @default("SENDING") @db.VarChar(10)
  recipients  Int       @default(0)
  sentCount   Int       @default(0)
  createdById Int?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@map("newsletters")
}

// ---------- Statistiques (anonymes : aucune donnée personnelle, aucun cookie) ----------

model PageView {
  id       Int      @id @default(autoincrement())
  day      DateTime @db.Date
  path     String   @db.VarChar(255)
  referrer String   @default("") @db.VarChar(191)
  device   String   @db.VarChar(10)
  views    Int      @default(0)

  @@unique([day, path, referrer, device])
  @@index([day])
  @@map("page_views")
}

model DailyVisitors {
  day      DateTime @id @db.Date
  visitors Int      @default(0)
  views    Int      @default(0)

  @@map("daily_visitors")
}

// ---------- Galerie ----------

model Album {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(191)
  description String?       @db.Text
  date        DateTime?     @db.Date
  coverId     Int?
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cover Media?      @relation(fields: [coverId], references: [id], onDelete: SetNull)
  items AlbumItem[]

  @@map("albums")
}

model AlbumItem {
  id        Int     @id @default(autoincrement())
  albumId   Int
  mediaId   Int?
  videoUrl  String? @db.VarChar(500)
  caption   String? @db.VarChar(255)
  sortOrder Int     @default(0)

  album Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([albumId, sortOrder])
  @@map("album_items")
}
