# Copier ce fichier en ".env" (jamais commité) et adapter les valeurs.

# --- Base de données ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sainte_lucie
MYSQL_USER=sainte_lucie
MYSQL_PASSWORD=change-me-db
MYSQL_HOST_PORT=3307

# --- Ports locaux ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
MAILPIT_UI_PORT=8025

# --- Production ---
PUBLIC_URL=http://localhost
HTTP_PORT=80

# --- Compte administrateur initial (créé par "npm run seed") ---
# Mot de passe : 10 caractères minimum. À changer immédiatement en production.
ADMIN_EMAIL=admin@paroissesaintelucie-baguida.org
ADMIN_PASSWORD=ChangeMe-Admin-2026

# --- Cookie de session ---
# En production derrière HTTPS : true. Pour tester la pile prod en HTTP local : false.
COOKIE_SECURE=true
