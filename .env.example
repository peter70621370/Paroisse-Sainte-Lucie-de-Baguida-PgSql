# Copier ce fichier en ".env" (jamais commité) et adapter les valeurs.

# --- Base de données ---
# Mot de passe : lettres et chiffres uniquement (il est repris tel quel dans l'adresse de connexion).
POSTGRES_DB=sainte_lucie
POSTGRES_USER=sainte_lucie
POSTGRES_PASSWORD=change-me-db
POSTGRES_HOST_PORT=5433

# --- Ports locaux ---
PGADMIN_PORT=5050
FRONTEND_PORT=3000
BACKEND_PORT=4000
MAILPIT_UI_PORT=8025

# --- Production ---
PUBLIC_URL=http://localhost
HTTP_PORT=80

# --- Compte administrateur initial (créé par "npm run seed") ---
# Mot de passe : 10 caractères minimum. À changer immédiatement en production.
ADMIN_EMAIL=admin@paroissesaintelucie-baguida.org
ADMIN_PASSWORD=ChangeMe-Admin-2026

# --- Cookie de session ---
# En production derrière HTTPS : true. Pour tester la pile prod en HTTP local : false.
COOKIE_SECURE=true

# --- E-mails des formulaires ---
# Dev : ignoré (Mailpit, http://localhost:8025). Production : serveur SMTP de la paroisse (ex. celui de l'hébergeur ou d'un service transactionnel).
NOTIFY_EMAIL=secretariat@paroissesaintelucie-baguida.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Paroisse Sainte Lucie de Baguida <no-reply@paroissesaintelucie-baguida.org>

# --- Dons en ligne (production) ---
# PUBLIC_URL : adresse publique du site (liens de retour et notifications des prestataires) : https://www.paroissesaintelucie-baguida.org
# Mobile Money + carte (FCFA) : compte marchand CinetPay. PayPal (euros) : application PayPal Developer.
# Tant qu'un moyen n'est pas configuré, il n'est pas proposé aux visiteurs. PAYPAL_ENV : sandbox (essais) ou live (réel).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Sécurité (production) ---
# Réseaux de confiance pour X-Forwarded-For (par défaut : réseaux privés Docker où seul Nginx est joignable). Ne pas modifier sans raison.
# TRUST_PROXY=loopback,linklocal,uniquelocal
